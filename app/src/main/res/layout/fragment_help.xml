<?xml version="1.0" encoding="utf-8"?>
<!-- 新手帮助：怎么配模型、语音、邮箱、生图（每节附官方网址） -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/d_space_xl"
        android:paddingEnd="@dimen/d_space_xl"
        android:paddingTop="@dimen/d_space_xl"
        android:paddingBottom="@dimen/d_space_2xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/help_back_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:text="‹"
                android:textColor="@color/d_ink"
                android:textSize="24sp" />

            <TextView
                style="@style/dText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="新手帮助" />
        </LinearLayout>

        <TextView
            style="@style/dText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="从零开始把 tiyo 配起来，大概十分钟。所有要申请的账号都附了官网链接，点一下能直接打开" />

        <!-- 接入模型 -->
        <TextView
            style="@style/dSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_xl"
            android:text="一、接入模型（任意兼容 API）" />

        <LinearLayout
            style="@style/dCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/dText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:autoLink="web"
                android:text="tiyo 支持 OpenAI 兼容的模型接口。\n\n1. 在模型服务商处创建 API Key\n2. 在 tiyo 聊天页顶部点「配置模型」，填写 API 地址、模型名和 Key\n3. 权限先选「谨慎确认」，需要时再放开\n\n· DeepSeek\n  平台：https://platform.deepseek.com\n  API 地址：https://api.deepseek.com/v1\n  默认模型：deepseek-v4-flash\n\n· OpenAI\n  平台：https://platform.openai.com\n  API 地址：https://api.openai.com/v1\n\n通义、Kimi、GLM、豆包等兼容服务也可以作为独立 Provider 添加。密钥只保存在本机加密存储中。" />
        </LinearLayout>

        <!-- 识图模型 -->
        <TextView
            style="@style/dSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_xl"
            android:text="二、识图模型（看照片用）" />

        <LinearLayout
            style="@style/dCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/dText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:autoLink="web"
                android:text="聊天图片由当前启用的 Provider 识别，因此当前模型必须支持图片输入。\n\n可以在「配置模型」里新增一个视觉 Provider，再填入该服务商自己的 API Key。快捷按钮只会填写 Agnes 的公开地址和模型名，不包含任何内置密钥。\n\n如果当前模型不支持视觉，文字聊天仍可使用，但看图会明确提示失败。" />
        </LinearLayout>

        <!-- MiniMax 语音 -->
        <TextView
            style="@style/dSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_xl"
            android:text="三、语音（MiniMax TTS）" />

        <LinearLayout
            style="@style/dCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/dText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:autoLink="web"
                android:text="1. 注册 MiniMax：https://platform.minimax.chat\n2. 进「密钥管理」创建一个 API Key\n3. 在 tiyo「配置模型」里把 Key 填进「MiniMax 语音 Key」\n4. 填好后语音按钮会自动扫出你账号下的音色，直接选\n\n· 文字转语音文档：https://www.minimax.chat/docs\n· 语音合成的音色都是平台内置的，不用自己训练" />
        </LinearLayout>

        <!-- 克隆声音 -->
        <TextView
            style="@style/dSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_xl"
            android:text="四、克隆专属音色" />

        <LinearLayout
            style="@style/dCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/dText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:autoLink="web"
                android:text="1. 在 MiniMax 平台找「声音克隆」：https://platform.minimax.chat\n2. 上传一段 10 秒到 1 分钟的清晰人声（安静环境、人声干净）\n3. 克隆成功后平台会给这个音色一个 voice_id\n4. 回到 tiyo，语音按钮会自动扫出这个克隆音色，直接选\n\n· 克隆用的是 MiniMax 的声音克隆功能，音色归你账号管" />
        </LinearLayout>

        <!-- QQ 邮箱授权码 -->
        <TextView
            style="@style/dSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_xl"
            android:text="五、QQ 邮箱授权码" />

        <LinearLayout
            style="@style/dCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/dText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:autoLink="web"
                android:text="1. 打开 QQ 邮箱：https://mail.qq.com 登录\n2. 设置 → 账户\n3. 找到「POP3/IMAP/SMTP/Exchange」，开启 IMAP/SMTP\n4. 按提示发一条短信验证，会生成 16 位授权码\n5. 把授权码填到「我的 → 邮箱与天气」\n　（授权码不是登录密码，是邮件专用的）\n\n· QQ 邮箱 SMTP/IMAP 说明：\n  https://mail.qq.com 设置页内的帮助文档" />
        </LinearLayout>

        <!-- agent 邮箱 -->
        <TextView
            style="@style/dSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_xl"
            android:text="六、收报告的 agent 邮箱" />

        <LinearLayout
            style="@style/dCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/dText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:autoLink="web"
                android:text="tiyo 的日报、预警会发到一个「agent 邮箱」。\n\n· 申请 @agent.qq.com 邮箱：在腾讯 agent 邮箱服务入口注册，把地址填到「我的 → 邮箱与天气 → 收报告邮箱」\n· 也可以直接用你自己的另一个邮箱\n· 没配的话邮件功能就不发，其他功能不受影响" />
        </LinearLayout>

        <!-- 邮件遥控 -->
        <TextView
            style="@style/dSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_xl"
            android:text="七、用邮件遥控 tiyo" />

        <LinearLayout
            style="@style/dCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/dText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="配好邮箱后，往你的 QQ 邮箱发带指令的邮件，手机收到就会执行：\n　tiyo-report 　　　　发今天的屏幕报告\n　tiyo-file 路径　　　　列出手机目录\n　tiyo-ring 　　　　　　手机响铃\n　tiyo-sms 号码|内容　发短信\n　tiyo-notify 内容　　　弹一条通知\n结果会回执到你的 agent 邮箱" />
        </LinearLayout>

        <!-- 生图 -->
        <TextView
            style="@style/dSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_xl"
            android:text="八、生图 API Key" />

        <LinearLayout
            style="@style/dCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/dText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:autoLink="web"
                android:text="生图是可选能力，在「配置模型 → 生图 Provider + 生图 API Key」中单独配置。\n\n· 智谱 GLM：https://open.bigmodel.cn\n· 豆包 seedream：https://console.volcengine.com/ark\n· OpenAI GPT Image：https://platform.openai.com\n\n使用 GPT Image 时，留空 API 地址会采用 https://api.openai.com，留空模型会采用 gpt-image-1。开放版不内置第三方中转地址或密钥。" />
        </LinearLayout>

        <!-- 新功能提醒 -->
        <TextView
            style="@style/dSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_xl"
            android:text="九、守护与提醒" />

        <LinearLayout
            style="@style/dCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/dText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="· 屏幕/步数/限额提醒：打开「我的 → 守护与权限」，开启对应权限后自动生效\n· 年龄人格：首次启动选的年龄段决定可又说话方式和表情包频率，随时可在「我的 → 人格与记忆」里换\n· 表情包管理：导入你自己的表情包、打标签，可又聊天时就能用，入口在「我的 → 表情包管理」\n· 定时定位查天气：授权后每 3 小时查一次当前位置天气，今天页显示；检测到你可能出门时提醒天气\n· 防诈骗提醒（50 岁以上档）：聊天里出现转账、中奖等可疑内容，可又先提醒再让你核实" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
