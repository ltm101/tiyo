<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F1E8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="40dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/assistant_avatar"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:contentDescription="@string/chat_avatar_description"
            android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/assistant_title"
            android:textColor="#342B27"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/assistant_subtitle"
            android:textColor="#81736B"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/assistant_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/assistant_waiting"
            android:textColor="#685C55"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/assistant_you_said"
            android:textColor="#9A7360"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/assistant_heard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/chat_user_bubble_bg"
            android:minHeight="58dp"
            android:padding="16dp"
            android:text="—"
            android:textColor="#342B27"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/assistant_reply"
            android:textColor="#9A7360"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/assistant_answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/chat_koyo_bubble_bg"
            android:minHeight="96dp"
            android:padding="16dp"
            android:text="@string/assistant_waiting"
            android:textColor="#342B27"
            android:textIsSelectable="true"
            android:textSize="16sp" />

        <Button
            android:id="@+id/assistant_role_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="@string/assistant_set_default"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/assistant_mic_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/assistant_start_listening"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <Button
            android:id="@+id/assistant_stop_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/assistant_stop_speaking"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
