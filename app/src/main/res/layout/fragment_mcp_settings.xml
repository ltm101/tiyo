<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/d_canvas"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/d_space_lg"
        android:paddingTop="@dimen/d_space_lg"
        android:paddingEnd="@dimen/d_space_lg"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mcp_back_btn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/d_ink"
                android:textSize="32sp" />

            <TextView
                style="@style/dText.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="自定义 MCP" />
        </LinearLayout>

        <TextView
            style="@style/dText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="44dp"
            android:text="把远程服务或本机命令接成 Agent 工具，保存后自动重载" />

        <TextView
            style="@style/dSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_xl"
            android:text="新连接" />

        <LinearLayout
            style="@style/dCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/mcp_name"
                style="@style/Tiyo.AgentField"
                android:hint="名称，例如 calendar"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:maxLines="1" />

            <RadioGroup
                android:id="@+id/mcp_transport_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/mcp_transport_http"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:buttonTint="@color/d_accent"
                    android:checked="true"
                    android:text="HTTP"
                    android:textColor="@color/d_ink_2"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/mcp_transport_sse"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:buttonTint="@color/d_accent"
                    android:text="SSE"
                    android:textColor="@color/d_ink_2"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/mcp_transport_stdio"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:buttonTint="@color/d_accent"
                    android:text="本机命令"
                    android:textColor="@color/d_ink_2"
                    android:textSize="13sp" />
            </RadioGroup>

            <EditText
                android:id="@+id/mcp_endpoint"
                style="@style/Tiyo.AgentField"
                android:layout_marginTop="8dp"
                android:hint="https://example.com/mcp"
                android:imeOptions="actionNext"
                android:inputType="textUri"
                android:maxLines="2" />

            <EditText
                android:id="@+id/mcp_args"
                style="@style/Tiyo.AgentField"
                android:layout_marginTop="8dp"
                android:hint="参数，例如 -y @scope/server"
                android:inputType="text"
                android:maxLines="3"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_mcp_save"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/chat_send_bg"
                android:gravity="center"
                android:text="保存并接入"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/mcp_status"
                style="@style/dText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <TextView
            style="@style/dSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_xl"
            android:text="已接入" />

        <LinearLayout
            android:id="@+id/mcp_server_list"
            style="@style/dCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
