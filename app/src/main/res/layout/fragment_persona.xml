<?xml version="1.0" encoding="utf-8"?>
<!-- 人格与记忆：性格设定（CLAUDE.md 风格，写 TIYO.md）+ 电脑记忆同步 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/d_space_xl"
        android:paddingEnd="@dimen/d_space_xl"
        android:paddingTop="@dimen/d_space_xl"
        android:paddingBottom="@dimen/d_space_2xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/persona_back_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:text="‹"
                android:textColor="@color/d_ink"
                android:textSize="24sp" />

            <TextView
                style="@style/dText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="人格与记忆" />
        </LinearLayout>

        <TextView
            style="@style/dText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="设定手机Tiyo的性格，并同步手机与电脑的记忆" />

        <!-- 年龄段切换 -->
        <TextView
            style="@style/dSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_xl"
            android:text="年龄段" />

        <LinearLayout
            style="@style/dCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/dText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tiyo的说话方式和表情包频率会跟着年龄调整，点一下就会把对应人格填进来" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/d_space_lg"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/persona_age_child"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/tiyo_chip_bg"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="0-15岁"
                    android:textColor="@color/d_ink"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/persona_age_youth"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/tiyo_chip_bg"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="16-30岁"
                    android:textColor="@color/d_ink"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/persona_age_middle"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/tiyo_chip_bg"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="30-60岁"
                    android:textColor="@color/d_ink"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/persona_age_elder"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/tiyo_chip_bg"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="60岁及以上"
                    android:textColor="@color/d_ink"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 性格设定 -->
        <TextView
            style="@style/dSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_xl"
            android:text="性格设定" />

        <LinearLayout
            style="@style/dCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/dText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="这段文字会写入 /sdcard/Tiyo/TIYO.md，Tiyo下次会话自动读取" />

            <EditText
                android:id="@+id/persona_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/d_space_sm"
                android:background="@drawable/d_chip_bg"
                android:gravity="top|start"
                android:hint="像写 CLAUDE.md 一样描述你想让Tiyo成为的样子"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:minHeight="180dp"
                android:padding="12dp"
                android:textColor="@color/d_ink"
                android:textColorHint="@color/d_ink_3"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_persona_save"
                style="@style/dButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/d_button_height"
                android:layout_marginTop="@dimen/d_space_lg"
                android:text="保存设定" />

            <TextView
                android:id="@+id/persona_save_status"
                style="@style/dText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/d_space_sm"
                android:text=""
                android:textColor="@color/d_ink_2" />
        </LinearLayout>

        <!-- 电脑记忆同步 -->
        <TextView
            style="@style/dSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_xl"
            android:text="电脑记忆同步" />

        <LinearLayout
            style="@style/dCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/dText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="手机和电脑连同一局域网时，一键同步两边的记忆" />

            <TextView
                style="@style/dText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/d_space_lg"
                android:text="电脑地址" />

            <EditText
                android:id="@+id/gateway_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/d_chip_bg"
                android:hint="http://192.168.1.10:8888"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="@color/d_ink"
                android:textColorHint="@color/d_ink_3"
                android:textSize="14sp" />

            <TextView
                style="@style/dText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/d_space_lg"
                android:text="配对密钥" />

            <EditText
                android:id="@+id/token_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/d_chip_bg"
                android:hint="电脑 KoyoGateway 的配对 token"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="@color/d_ink"
                android:textColorHint="@color/d_ink_3"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_save_pairing"
                style="@style/dButton.Ghost"
                android:layout_width="match_parent"
                android:layout_height="@dimen/d_button_height"
                android:layout_marginTop="@dimen/d_space_lg"
                android:text="保存配对" />

            <Button
                android:id="@+id/btn_sync_now"
                style="@style/dButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/d_button_height"
                android:layout_marginTop="@dimen/d_space_sm"
                android:text="立即同步" />

            <TextView
                android:id="@+id/sync_status"
                style="@style/dText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/d_space_sm"
                android:text=""
                android:textColor="@color/d_ink_2" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
