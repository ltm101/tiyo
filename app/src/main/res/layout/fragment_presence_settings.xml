<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/d_space_xl"
        android:paddingTop="@dimen/d_space_xl"
        android:paddingEnd="@dimen/d_space_xl"
        android:paddingBottom="@dimen/d_space_2xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/presence_back"
                android:layout_width="@dimen/d_touch_target"
                android:layout_height="@dimen/d_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/d_ink"
                android:textSize="24sp" />

            <TextView
                style="@style/dText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/d_space_sm"
                android:text="接入其他应用" />
        </LinearLayout>

        <TextView
            style="@style/dText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_sm"
            android:text="每个应用只是可又的一个身体，消息仍使用同一人格、记忆与安全出口" />

        <TextView
            style="@style/dSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_xl"
            android:text="当前能力" />

        <LinearLayout
            style="@style/dCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/presence_capability_summary"
                style="@style/dText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/d_ink" />
        </LinearLayout>

        <TextView
            style="@style/dSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_xl"
            android:text="手机原生通道" />

        <LinearLayout
            style="@style/dCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/presence_feishu_enabled"
                android:layout_width="match_parent"
                android:layout_height="@dimen/d_touch_target"
                android:text="飞书机器人"
                android:textColor="@color/d_ink" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/presence_wecom_enabled"
                android:layout_width="match_parent"
                android:layout_height="@dimen/d_touch_target"
                android:text="企业微信机器人"
                android:textColor="@color/d_ink" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/presence_qq_enabled"
                android:layout_width="match_parent"
                android:layout_height="@dimen/d_touch_target"
                android:text="QQ 官方机器人"
                android:textColor="@color/d_ink" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/presence_wechat_enabled"
                android:layout_width="match_parent"
                android:layout_height="@dimen/d_touch_target"
                android:text="微信独立联系人"
                android:textColor="@color/d_ink" />

            <TextView
                android:id="@+id/presence_bot_status"
                style="@style/dText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/d_space_sm"
                android:text="凭据加密保存在手机里，Tiyo 自己保持连接" />

            <Button
                android:id="@+id/presence_bot_save"
                style="@style/dButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/d_button_height"
                android:layout_marginTop="@dimen/d_space_lg"
                android:text="配置并保存手机通道" />

            <Button
                android:id="@+id/presence_bot_health"
                style="@style/dButton.Ghost"
                android:layout_width="match_parent"
                android:layout_height="@dimen/d_button_height"
                android:layout_marginTop="@dimen/d_space_sm"
                android:text="检查手机连接（不调用模型）" />
        </LinearLayout>

        <TextView
            style="@style/dText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_xl"
            android:text="飞书、企业微信、QQ 与微信连接均由 Tiyo 手机端保持；小红书、微博、B站等暂时通过系统分享发给可又" />
    </LinearLayout>
</ScrollView>
