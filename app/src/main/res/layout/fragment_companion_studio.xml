<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/d_space_xl"
        android:paddingTop="@dimen/d_space_xl"
        android:paddingEnd="@dimen/d_space_xl"
        android:paddingBottom="@dimen/d_space_2xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/companion_studio_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:text="‹"
                android:textColor="@color/d_ink"
                android:textSize="24sp" />

            <TextView
                style="@style/dText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="伴生角色" />
        </LinearLayout>

        <TextView
            style="@style/dText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:tag="tiyo_keep_builtin_name"
            android:text="可又负责带你认识和设置 Tiyo，新角色拥有独立的名字、人格、聊天、记忆和视觉资源" />

        <TextView
            style="@style/dSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_xl"
            android:text="已经认识的角色" />

        <LinearLayout
            style="@style/dCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/companion_koyo_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:tag="tiyo_keep_builtin_name">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/d_avatar_bg"
                    android:contentDescription="可又 · Tiyo 引导者"
                    android:padding="2dp"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_launcher" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/d_space_lg"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/dText.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="可又"
                        android:textColor="@color/d_ink" />

                    <TextView
                        style="@style/dText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Tiyo 引导者 · 随时可以找她" />
                </LinearLayout>

                <TextView
                    android:id="@+id/companion_koyo_state"
                    style="@style/dText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="正在使用"
                    android:textColor="@color/d_accent" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/companion_profile_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            style="@style/dSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_xl"
            android:text="创造一位同行者" />

        <LinearLayout
            style="@style/dCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/dText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="先建立名字和出生证草稿，确认长相之前不会替换任何现有角色" />

            <EditText
                android:id="@+id/companion_name_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/d_space_lg"
                android:background="@drawable/d_chip_bg"
                android:hint="她或他的名字"
                android:importantForAutofill="no"
                android:inputType="textPersonName"
                android:maxLength="16"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/d_ink"
                android:textColorHint="@color/d_ink_3"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/companion_consent_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/d_space_lg"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/companion_consent_self"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="使用我本人的照片"
                    android:textColor="@color/d_ink"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/companion_consent_authorized"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="已获得照片中成年人的明确授权"
                    android:textColor="@color/d_ink"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/companion_consent_original"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="使用我有权使用的原创角色图"
                    android:textColor="@color/d_ink"
                    android:textSize="14sp" />
            </RadioGroup>

            <Button
                android:id="@+id/companion_create_draft"
                style="@style/dButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/d_button_height"
                android:layout_marginTop="@dimen/d_space_lg"
                android:text="建立角色草稿" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/companion_birth_card"
            style="@style/dCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_lg"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/companion_birth_title"
                style="@style/dText.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="角色出生证"
                android:textColor="@color/d_ink" />

            <TextView
                android:id="@+id/companion_birth_status"
                style="@style/dText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="等待参考图" />

            <Button
                android:id="@+id/companion_pick_references"
                style="@style/dButton.Ghost"
                android:layout_width="match_parent"
                android:layout_height="@dimen/d_button_height"
                android:layout_marginTop="@dimen/d_space_lg"
                android:text="选择 1—3 张参考图" />

            <Button
                android:id="@+id/companion_generate_anchor"
                style="@style/dButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/d_button_height"
                android:layout_marginTop="@dimen/d_space_sm"
                android:enabled="false"
                android:text="生成角色出生证" />

            <ImageView
                android:id="@+id/companion_anchor_preview"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="@dimen/d_space_lg"
                android:background="@drawable/d_chip_bg"
                android:contentDescription="角色出生证预览"
                android:scaleType="centerInside"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/companion_anchor_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/d_space_sm"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/companion_reject_anchor"
                    style="@style/dButton.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/d_button_height"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="重新生成" />

                <Button
                    android:id="@+id/companion_approve_anchor"
                    style="@style/dButton.Primary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/d_button_height"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="确认是她／他" />
            </LinearLayout>

            <Button
                android:id="@+id/companion_build_pack"
                style="@style/dButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/d_button_height"
                android:layout_marginTop="@dimen/d_space_lg"
                android:text="生成完整角色资源包"
                android:visibility="gone" />

            <TextView
                android:id="@+id/companion_generation_cost"
                style="@style/dText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="开始前会显示预计生图次数"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/companion_pack_preview"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="@dimen/d_space_lg"
                android:background="@drawable/d_chip_bg"
                android:contentDescription="角色动作母版预览"
                android:scaleType="centerInside"
                android:visibility="gone" />

            <TextView
                android:id="@+id/companion_quality_report"
                style="@style/dText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/d_space_sm"
                android:lineSpacingExtra="3dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/companion_refine_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/d_space_sm"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/companion_refine"
                    style="@style/dButton.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/d_button_height"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="单项精修" />

                <Button
                    android:id="@+id/companion_rollback"
                    style="@style/dButton.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/d_button_height"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="撤回精修"
                    android:visibility="gone" />
            </LinearLayout>

            <Button
                android:id="@+id/companion_activate"
                style="@style/dButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/d_button_height"
                android:layout_marginTop="@dimen/d_space_lg"
                android:text="启用这个角色"
                android:visibility="gone" />

            <TextView
                android:id="@+id/companion_image_capability"
                style="@style/dText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/d_space_lg"
                android:text="正在检查生图能力" />

            <Button
                android:id="@+id/companion_erase"
                style="@style/dButton.Ghost"
                android:layout_width="match_parent"
                android:layout_height="@dimen/d_button_height"
                android:layout_marginTop="@dimen/d_space_lg"
                android:text="删除这个角色与参考图"
                android:textColor="@color/tiyo_error" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
