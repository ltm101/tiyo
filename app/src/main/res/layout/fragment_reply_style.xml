<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/d_canvas"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/d_space_lg"
        android:paddingEnd="@dimen/d_space_lg"
        android:paddingTop="@dimen/d_space_xl"
        android:paddingBottom="@dimen/d_space_xl">

        <TextView
            style="@style/dText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="回复性格" />

        <TextView
            style="@style/dText.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="收到消息时，可又按这里的要求帮你拟回复"
            android:textColor="@color/d_ink_3" />

        <!-- 性格描述 -->
        <LinearLayout
            style="@style/dCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_lg"
            android:orientation="vertical">

            <TextView
                style="@style/dSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="性格描述" />

            <EditText
                android:id="@+id/style_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/d_composer_bg"
                android:fontFamily="sans-serif"
                android:gravity="top|start"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:maxLines="6"
                android:minLines="3"
                android:padding="12dp"
                android:textColor="@color/d_ink"
                android:textColorHint="@color/d_ink_3"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 保存 / 重置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_lg"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_style_save"
                style="@style/dChip"
                android:text="保存" />

            <TextView
                android:id="@+id/btn_style_reset"
                style="@style/dChip"
                android:layout_marginStart="8dp"
                android:text="重置为默认" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/d_space_xl"
            android:background="@color/d_line" />

        <!-- 一键克隆 -->
        <TextView
            style="@style/dSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_xl"
            android:text="一键克隆" />

        <TextView
            style="@style/dText.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="把你回复别人的聊天记录样本贴进来，分析后自动生成性格描述"
            android:textColor="@color/d_ink_3" />

        <EditText
            android:id="@+id/sample_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_lg"
            android:background="@drawable/d_composer_bg"
            android:fontFamily="sans-serif"
            android:gravity="top|start"
            android:hint="粘贴你回复别人的聊天记录样本，最好是你自己发的话"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:maxLines="8"
            android:minLines="4"
            android:padding="12dp"
            android:textColor="@color/d_ink"
            android:textColorHint="@color/d_ink_3"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_lg"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_style_import"
                style="@style/dChip"
                android:text="导入文件" />

            <TextView
                android:id="@+id/btn_style_clone"
                style="@style/dChip"
                android:layout_marginStart="8dp"
                android:text="分析克隆" />
        </LinearLayout>

        <TextView
            android:id="@+id/style_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_lg"
            android:fontFamily="sans-serif"
            android:text=""
            android:textColor="@color/d_accent_deep"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
