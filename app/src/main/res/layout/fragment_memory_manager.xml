<?xml version="1.0" encoding="utf-8"?>
<!-- 记忆管理：全量记忆列表 + 只看重要 + 待同步提示 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/d_space_xl"
        android:paddingEnd="@dimen/d_space_xl"
        android:paddingTop="@dimen/d_space_xl"
        android:paddingBottom="@dimen/d_space_2xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/memory_back_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:text="‹"
                android:textColor="@color/d_ink"
                android:textSize="24sp" />

            <TextView
                style="@style/dText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="记忆管理" />
        </LinearLayout>

        <EditText
            android:id="@+id/memory_search_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_lg"
            android:background="@drawable/d_card_bg"
            android:hint="搜索记忆…"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:padding="@dimen/d_space_md"
            android:textColor="@color/d_ink"
            android:textColorHint="@color/d_ink_3"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/memory_filter_important"
                style="@style/dChip"
                android:text="只看重要的" />

            <TextView
                android:id="@+id/memory_count"
                style="@style/dText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/d_space_lg"
                android:text=""
                android:textColor="@color/d_ink_2" />
        </LinearLayout>

        <TextView
            android:id="@+id/memory_sync_hint"
            style="@style/dText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_sm"
            android:text=""
            android:textColor="@color/d_ink_2" />

        <LinearLayout
            style="@style/dCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_lg"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/memory_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            android:id="@+id/memory_empty"
            style="@style/dText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_2xl"
            android:gravity="center"
            android:text="Tiyo还没记下什么。去和Tiyo聊聊天吧"
            android:textColor="@color/d_ink_3"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
