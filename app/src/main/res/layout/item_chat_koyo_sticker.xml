<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingStart="0dp"
    android:paddingEnd="30dp">

    <ImageView
        android:id="@+id/chat_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/chat_avatar_bg"
        android:contentDescription="@string/chat_koyo_name"
        android:padding="1dp"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/chat_sticker_image"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:background="@drawable/chat_koyo_bubble_bg"
            android:padding="6dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/chat_message_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/chat_koyo_bubble_bg"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="3dp"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7dp"
            android:textColor="@color/d_focus_ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/chat_message_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/d_focus_ink_3"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
