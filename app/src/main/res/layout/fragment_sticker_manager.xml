<?xml version="1.0" encoding="utf-8"?>
<!-- 表情包管理：导入用户表情包（命名 + 打标签）、编辑标签、删除自己的 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/d_space_xl"
        android:paddingEnd="@dimen/d_space_xl"
        android:paddingTop="@dimen/d_space_xl"
        android:paddingBottom="@dimen/d_space_2xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sticker_back_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:text="‹"
                android:textColor="@color/d_ink"
                android:textSize="24sp" />

            <TextView
                style="@style/dText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="表情包管理" />
        </LinearLayout>

        <TextView
            style="@style/dText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="导入你自己的表情包，给它起个名字、打上标签，可又聊天时就能用上" />

        <Button
            android:id="@+id/sticker_import_btn"
            style="@style/dButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/d_button_height"
            android:layout_marginTop="@dimen/d_space_lg"
            android:text="导入表情包" />

        <!-- 我的表情包 -->
        <TextView
            style="@style/dSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_xl"
            android:text="我的表情包" />

        <LinearLayout
            style="@style/dCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_sm"
            android:orientation="vertical">

            <GridLayout
                android:id="@+id/sticker_user_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:rowCount="1" />

            <TextView
                android:id="@+id/sticker_user_empty"
                style="@style/dText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/d_space_lg"
                android:paddingBottom="@dimen/d_space_lg"
                android:gravity="center"
                android:text="还没有自己的表情包，点上面导入一张吧"
                android:textColor="@color/d_ink_3" />
        </LinearLayout>

        <!-- 内置表情包 -->
        <TextView
            style="@style/dSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_xl"
            android:text="内置表情包" />

        <LinearLayout
            style="@style/dCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_sm"
            android:orientation="vertical">

            <GridLayout
                android:id="@+id/sticker_builtin_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:rowCount="1" />
        </LinearLayout>

        <TextView
            style="@style/dText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_lg"
            android:text="点表情包可以给标签补充场景，比如「哄人」「庆祝」。标签越多，可又选得越准" />

    </LinearLayout>
</ScrollView>
