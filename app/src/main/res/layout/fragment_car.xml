<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F1E8">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="32dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="小车控制台"
        android:textColor="#292722"
        android:textSize="26sp"
        android:textStyle="bold"
        android:letterSpacing="-0.02" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="18dp"
        android:text="驾驶、视觉追踪与声音调试集中在这里"
        android:textColor="#817A70"
        android:textSize="13sp" />

    <!-- ═══ Card 1: 连接 ═══ -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFCF6"
        app:contentPadding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="主控 · 电机 / 对话 / 放音"
                android:textColor="#716B62"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <EditText
                android:id="@+id/et_car_ip"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/input_car_bg"
                android:hint="ESP32-S3 地址"
                android:text="http://koyo-car.local"
                android:textColor="#292722"
                android:textColorHint="#9A9388"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:inputType="textUri" />

            <Button
                android:id="@+id/btn_test"
                android:layout_width="78dp"
                android:layout_height="44dp"
                android:layout_marginLeft="10dp"
                android:text="自动连接"
                android:textColor="#fff"
                android:textSize="11sp"
                android:background="@drawable/btn_dpad_bg" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="7dp"
                android:text="视觉 · ESP32-CAM"
                android:textColor="#716B62"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_camera_ip"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_car_bg"
                    android:hint="ESP32-CAM 地址"
                    android:textColor="#292722"
                    android:textColorHint="#9A9388"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:inputType="textUri" />

                <Button
                    android:id="@+id/btn_camera_connect"
                    android:layout_width="64dp"
                    android:layout_height="44dp"
                    android:layout_marginLeft="10dp"
                    android:text="预览"
                    android:textColor="#4A453E"
                    android:textSize="13sp"
                    android:background="@drawable/btn_secondary_bg" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_gateway_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="电脑网关：等待检测"
                android:textColor="#817A70"
                android:textSize="11sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ═══ Card 2: 摄像头 ═══ -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFCF6"
        app:contentPadding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="摄像头"
                android:textColor="#716B62"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp">

                <ImageView
                    android:id="@+id/iv_camera"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/camera_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/camera_placeholder_bg"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📷"
                        android:textSize="40sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="等待连接..."
                        android:textColor="#817A70"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tv_stream_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未连接"
                android:textColor="#8A8378"
                android:textSize="11sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ═══ Card 3: 方向控制 ═══ -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFCF6"
        app:contentPadding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="方向控制"
                android:textColor="#716B62"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btn_fwd"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:text="前进"
                android:textColor="#fff"
                android:textSize="18sp"
                android:layout_margin="5dp"
                android:background="@drawable/btn_dpad_bg" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_left"
                    android:layout_width="90dp"
                    android:layout_height="65dp"
                    android:text="左转"
                    android:textColor="#fff"
                    android:textSize="16sp"
                    android:layout_margin="5dp"
                    android:background="@drawable/btn_dpad_bg" />

                <Button
                    android:id="@+id/btn_stop"
                    android:layout_width="90dp"
                    android:layout_height="65dp"
                    android:text="停"
                    android:textColor="#fff"
                    android:textSize="16sp"
                    android:layout_margin="5dp"
                    android:background="@drawable/btn_stop_bg" />

                <Button
                    android:id="@+id/btn_right"
                    android:layout_width="90dp"
                    android:layout_height="65dp"
                    android:text="右转"
                    android:textColor="#fff"
                    android:textSize="16sp"
                    android:layout_margin="5dp"
                    android:background="@drawable/btn_dpad_bg" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_back"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:text="后退"
                android:textColor="#fff"
                android:textSize="18sp"
                android:layout_margin="5dp"
                android:background="@drawable/btn_dpad_bg" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ═══ Card 4: 速度 ═══ -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFCF6"
        app:contentPadding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="速度"
                android:textColor="#716B62"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_speed_down"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="−"
                    android:textColor="#fff"
                    android:textSize="24sp"
                    android:background="@drawable/btn_dpad_bg" />

                <TextView
                    android:id="@+id/tv_speed"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="50"
                    android:textColor="#292722"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <Button
                    android:id="@+id/btn_speed_up"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="+"
                    android:textColor="#fff"
                    android:textSize="24sp"
                    android:background="@drawable/btn_dpad_bg" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ═══ Card 5: 颜色追踪 ═══ -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFCF6"
        app:contentPadding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="颜色追踪"
                android:textColor="#716B62"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_track_red"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="红"
                    android:textColor="#fff"
                    android:layout_margin="5dp"
                    android:background="@drawable/btn_track_red_bg" />

                <Button
                    android:id="@+id/btn_track_yellow"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="黄"
                    android:textColor="#fff"
                    android:layout_margin="5dp"
                    android:background="@drawable/btn_track_yellow_bg" />

                <Button
                    android:id="@+id/btn_track_black"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="黑"
                    android:textColor="#fff"
                    android:layout_margin="5dp"
                    android:background="@drawable/btn_track_black_bg" />

                <Button
                    android:id="@+id/btn_track_blue"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="蓝"
                    android:textColor="#fff"
                    android:layout_margin="5dp"
                    android:background="@drawable/btn_track_blue_bg" />

                <Button
                    android:id="@+id/btn_track_off"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="关"
                    android:textColor="#fff"
                    android:layout_margin="5dp"
                    android:background="@drawable/btn_track_off_bg" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ═══ Card 6: OLED 表情 ═══ -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFCF6"
        app:contentPadding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="OLED 表情"
                    android:textColor="#716B62"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_oled_expression"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="当前：待机"
                    android:textColor="#9A9388"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_emoji_happy"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_margin="3dp"
                    android:text="开心"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_dpad_bg" />

                <Button
                    android:id="@+id/btn_emoji_worried"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_margin="3dp"
                    android:text="担心"
                    android:textColor="#4A453E"
                    android:background="@drawable/btn_secondary_bg" />

                <Button
                    android:id="@+id/btn_emoji_sad"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_margin="3dp"
                    android:text="难过"
                    android:textColor="#4A453E"
                    android:background="@drawable/btn_secondary_bg" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_emoji_angry"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_margin="3dp"
                    android:text="生气"
                    android:textColor="#4A453E"
                    android:background="@drawable/btn_secondary_bg" />

                <Button
                    android:id="@+id/btn_emoji_gentle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_margin="3dp"
                    android:text="温柔"
                    android:textColor="#4A453E"
                    android:background="@drawable/btn_secondary_bg" />

                <Button
                    android:id="@+id/btn_emoji_excited"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_margin="3dp"
                    android:text="兴奋"
                    android:textColor="#4A453E"
                    android:background="@drawable/btn_secondary_bg" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_emoji_idle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="3dp"
                android:text="恢复待机"
                android:textColor="#4A453E"
                android:background="@drawable/btn_secondary_bg" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ═══ Card 7: 语音对话 ═══ -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#292722"
        app:contentPadding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="和可又说话"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="手机识别文字，小车负责思考和回答"
                    android:textColor="#BDB5AA"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_mic"
                android:layout_width="120dp"
                android:layout_height="48dp"
                android:text="和小车说话"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="@drawable/btn_dpad_bg" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ═══ Card 7: 放音调试 ═══ -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFCF6"
        app:contentPadding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="声音调试"
                android:textColor="#716B62"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="检查 ESP32-S3 → MAX98357A → 扬声器链路"
                android:textColor="#9A9388"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_audio_test"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="播放测试音"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_dpad_bg" />

                <Button
                    android:id="@+id/btn_audio_stop"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="停止"
                    android:textAllCaps="false"
                    android:textColor="#4A453E"
                    android:background="@drawable/btn_secondary_bg" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ═══ 状态 ═══ -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="等待连接小车"
        android:textColor="#817A70"
        android:textSize="12sp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp" />

</LinearLayout>
</ScrollView>
