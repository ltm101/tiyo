<?xml version="1.0" encoding="utf-8"?>
<!-- 引导卡单行：想要什么 + 为什么 + 去开启 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/d_space_sm"
    android:paddingBottom="@dimen/d_space_sm">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/perm_row_title"
            style="@style/dText.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/d_ink"
            android:text="" />

        <TextView
            android:id="@+id/perm_row_reason"
            style="@style/dText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="" />
    </LinearLayout>

    <Button
        android:id="@+id/perm_row_button"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="去开启"
        android:textColor="@color/d_accent_deep"
        android:textSize="13sp" />
</LinearLayout>
