<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="16dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:text="文件工作台"
                android:textColor="@color/tiyo_ink"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/file_scope_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tiyo 工作区 · Agent 可以直接使用"
                android:textColor="@color/tiyo_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/file_new_btn"
            style="@style/Tiyo.ChatAction"
            android:text="新建" />

        <TextView
            android:id="@+id/file_import_btn"
            style="@style/Tiyo.ChatAction"
            android:layout_marginStart="7dp"
            android:text="导入" />
    </LinearLayout>

    <!-- 今日任务（从 Today 挪到工作台） -->
    <TextView
        style="@style/dSectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/d_space_md"
        android:text="今日任务" />

    <LinearLayout
        style="@style/dCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ws_tasks_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/ws_tasks_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_space_sm"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:text="＋ 添加任务"
            android:textColor="@color/d_accent_deep"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/tiyo_panel_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/file_workspace_btn"
            style="@style/Tiyo.ChatAction"
            android:text="Tiyo" />

        <TextView
            android:id="@+id/file_phone_btn"
            style="@style/Tiyo.ChatAction"
            android:layout_marginStart="6dp"
            android:text="手机" />

        <TextView
            android:id="@+id/file_back_btn"
            android:layout_width="42dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/chat_secondary_button_bg"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="上级"
            android:textColor="@color/tiyo_ink_soft"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/file_search_btn"
            android:layout_width="42dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/chat_secondary_button_bg"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="查找"
            android:textColor="@color/tiyo_ink_soft"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/file_path_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="start"
            android:fontFamily="monospace"
            android:gravity="end"
            android:maxLines="1"
            android:text="/storage/emulated/0/Tiyo"
            android:textColor="@color/tiyo_ink_soft"
            android:textSize="10sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/tiyo_panel_bg"
        android:paddingStart="5dp"
        android:paddingTop="5dp"
        android:paddingEnd="5dp"
        android:paddingBottom="5dp">

        <ListView
            android:id="@+id/file_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@color/tiyo_line"
            android:dividerHeight="1dp"
            android:overScrollMode="never"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/file_empty_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="这里还没有文件\n可以新建一个项目，或者从手机导入"
            android:textColor="@color/tiyo_muted"
            android:textSize="13sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/file_hint_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="3dp"
        android:text="点按打开 · 长按管理 · HTML 可直接预览"
        android:textColor="@color/tiyo_muted"
        android:textSize="10sp" />

</LinearLayout>
